# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Google Calendar Configuration
GOOGLE_CALENDAR_ID=danielmoyemanizales@gmail.com
GOOGLE_MEET_LINK=https://meet.google.com/your-meet-code

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
PORT=3010
NODE_ENV=development
LOG_LEVEL=info

# Frontend URLs permitidas para CORS (separadas por coma)
FRONTEND_URLS=http://localhost:5173,http://localhost:3001,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Web Search (Serper API - opcional)
SERPER_API_KEY=

# Media / Adjuntos
# Hosts permitidos para proxyear media de Twilio (separados por coma)
TWILIO_MEDIA_HOSTS=api.twilio.com

# Descarga de media desde Twilio (límites para estabilidad/costos)
TWILIO_MEDIA_TIMEOUT_MS=10000
TWILIO_MEDIA_MAX_BYTES=15728640

# Proxy de media (límites para evitar SSRF/DoS)
MEDIA_PROXY_TIMEOUT_MS=10000
MEDIA_PROXY_MAX_BYTES=15728640

# TTL de Signed URLs de Supabase Storage (segundos)
MEDIA_SIGNED_URL_EXPIRES_IN=86400
